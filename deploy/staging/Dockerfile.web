FROM node:24.21.0-bookworm-slim AS build
WORKDIR /app
COPY public-web/package.json public-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY public-web/ ./
ARG NEXT_PUBLIC_BPT_API_BASE_URL
ARG NEXT_PUBLIC_BPT_AUTHORITY
ARG NEXT_PUBLIC_BPT_SELLER_CLIENT_ID=BomPraTi_SellerWeb
ARG NEXT_PUBLIC_BPT_BUYER_CLIENT_ID=BomPraTi_BuyerWeb
ENV NEXT_PUBLIC_BPT_API_BASE_URL=$NEXT_PUBLIC_BPT_API_BASE_URL
ENV NEXT_PUBLIC_BPT_AUTHORITY=$NEXT_PUBLIC_BPT_AUTHORITY
ENV NEXT_PUBLIC_BPT_SELLER_CLIENT_ID=$NEXT_PUBLIC_BPT_SELLER_CLIENT_ID
ENV NEXT_PUBLIC_BPT_BUYER_CLIENT_ID=$NEXT_PUBLIC_BPT_BUYER_CLIENT_ID
RUN npm run build

FROM node:24.21.0-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node","server.js"]
